{
  "name": "landing-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --project demo-congresoacho --import ./.emulator-data --export-on-exit ./.emulator-data",
    "emulators:fresh": "firebase emulators:start --project demo-congresoacho",
    "emulators:users": "tsx scripts/emulator-users.ts",
    "set-role": "tsx scripts/set-role.ts",
    "test": "vitest run tests/unit",
    "test:firebase": "firebase emulators:exec --config firebase.test.json --only auth,firestore,storage --project demo-congresoacho-test \"vitest run tests/rules tests/integration\"",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run test:firebase"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@puckeditor/core": "^0.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.68.0",
    "nanoid": "^5.1.16",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.17.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  }
}
