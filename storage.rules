rules_version = '2';

// Estructura:
//   landing-pages/{pageId}/{images|videos|documents}/{mediaId}/{archivo}
//   shared/{images|videos|logos|icons|documents}/{mediaId}/{archivo}
//   templates/{images|videos}/{mediaId}/{archivo}
//   private/**  -> archivos internos del administrador (nunca públicos)
//
// Los recursos de landing-pages/, shared/ y templates/ son de lectura pública porque
// los consume la landing publicada. No subas ahí material confidencial.
service firebase.storage {
  match /b/{bucket}/o {

    function role() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }
    function canEdit() {
      return role() in ['admin', 'editor'];
    }
    function isStaff() {
      return role() in ['admin', 'editor', 'viewer'];
    }
    function sizeUnderMb(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }
    // SVG queda excluido a propósito: puede contener scripts.
    function isImage() {
      return request.resource.contentType.matches('image/(png|jpeg|webp|gif|avif)');
    }
    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime|ogg)');
    }
    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }
    function hasSafeExtension(file) {
      return file.matches('(?i)^[a-z0-9._-]{1,120}\\.(png|jpe?g|webp|gif|avif|mp4|webm|mov|ogv|pdf)$');
    }
    // Miniaturas generadas en el navegador (también para videos).
    function isThumbnail(file) {
      return file == 'thumb.webp' && isImage() && sizeUnderMb(1);
    }
    function validUpload(folder, file) {
      return hasSafeExtension(file) && (
        isThumbnail(file)
        || (folder in ['images', 'logos', 'icons'] && isImage() && sizeUnderMb(10))
        || (folder == 'videos' && isVideo() && sizeUnderMb(200))
        || (folder == 'documents' && isPdf() && sizeUnderMb(20))
      );
    }

    match /landing-pages/{pageId}/{folder}/{mediaId}/{file} {
      allow read: if true;
      allow create, update: if canEdit() && validUpload(folder, file);
      allow delete: if canEdit();
    }

    match /shared/{folder}/{mediaId}/{file} {
      allow read: if true;
      allow create, update: if canEdit() && validUpload(folder, file);
      allow delete: if canEdit();
    }

    match /templates/{folder}/{mediaId}/{file} {
      allow read: if true;
      allow create, update: if canEdit() && validUpload(folder, file);
      allow delete: if canEdit();
    }

    match /private/{allPaths=**} {
      allow read: if isStaff();
      allow write: if canEdit() && (request.resource == null || sizeUnderMb(20));
    }

    // Cualquier otra ruta queda denegada por defecto.
  }
}
